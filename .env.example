# Copy to .env if you want local overrides. Never commit .env.
# All variables are optional; defaults are safe for a local demo.

# Path to the YAML policy. Relative paths are resolved from the process working directory
# unless you pass an absolute path. Run commands from the repository root.
GUARDRAILS_POLICY_PATH=policies/default.yaml

# DEBUG, INFO, WARNING, ERROR
GUARDRAILS_LOG_LEVEL=INFO

# JSON lines on stdout. Set to false for a colorized console renderer.
GUARDRAILS_LOG_JSON=true

# Keep this false. When true, inspect/sanitize logs include a truncated copy of the text.
# Prompts and completions often contain the exact PII and secrets this service is meant to catch.
GUARDRAILS_LOG_PROMPTS=false

GUARDRAILS_HOST=127.0.0.1
GUARDRAILS_PORT=8000
